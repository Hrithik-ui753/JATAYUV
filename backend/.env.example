# =============================================================================
# JATAYUV-AI Platform — Environment Configuration Example
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-value

# --- Database ---
# SQLite (development default — no server required)
DATABASE_URL=sqlite:///./storage/jatayuv.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://jatayuv:jatayuv_pass@localhost:5432/jatayuv

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
# Absolute path to the storage directory (defaults to ./storage relative to project root)
# STORAGE_DIR=/data/jatayuv/storage

# --- Feature Flags ---
# Set to "false" in production to enforce JWT authentication on all routes
ALLOW_ANONYMOUS_ACCESS=true

# --- CORS ---
# Add your frontend origin(s) separated by commas (no spaces)
# BACKEND_CORS_ORIGINS=https://app.jatayuv.ai,http://localhost:3000

